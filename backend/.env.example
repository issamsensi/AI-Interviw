DATABASE_URL=sqlite+aiosqlite:///./interview.db
REDIS_URL=redis://localhost:6379/0
META_API_KEY=your_meta_api_key_here
META_API_BASE=https://api.meta.ai/v1
META_MODEL_DEV=muse-spark-1.3
META_MODEL_PROD=muse-spark-1.3
META_ENV=dev
# Optional: server-side TTS. Leave empty to use browser speechSynthesis.
ELEVENLABS_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_RESUME_SIZE_BYTES=5242880
MAX_RESUME_TEXT_CHARS=50000
MAX_JOB_DESCRIPTION_CHARS=12000

# Supabase Auth: project URL used to verify user JWTs (JWKS). The database
# itself stays on DATABASE_URL above; point that at the Supabase Postgres
# connection string to move data to Supabase.
SUPABASE_URL=https://nnplolajhdxuxmhupnjx.supabase.co
# Guest (no-account) trial limits.
GUEST_MAX_QUESTIONS=5
GUEST_MAX_DURATION_MINUTES=10
