POSTGRES_USER=ai_interview
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=ai_interview
DATABASE_URL=postgresql+asyncpg://ai_interview:replace_with_a_strong_password@db:5432/ai_interview
META_API_KEY=your_meta_api_key_here
META_API_BASE=https://api.meta.ai/v1
META_MODEL_DEV=muse-spark-1.3
META_MODEL_PROD=muse-spark-1.3
META_ENV=dev
# Optional: server-side TTS. Leave empty to use browser speechSynthesis.
ELEVENLABS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Frontend build-time backend origin (used by docker-compose frontend build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Supabase Auth (Project Settings -> API Keys). The anon/publishable key
# is safe to expose in the browser; never put a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://nnplolajhdxuxmhupnjx.supabase.co
# Paste your anon/publishable key (sb_publishable_... or eyJ...) after the = :
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend: same project URL, used to verify user tokens (JWKS).
SUPABASE_URL=https://nnplolajhdxuxmhupnjx.supabase.co
